<Window x:Class="RtlTerminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:RtlTerminal"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RtlTerminal"
        Icon="RtlTerminal.ico"
        Width="980"
        Height="620"
        MinWidth="480"
        MinHeight="300"
        UseLayoutRounding="True"
        Background="#0c0c0c"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="TerminalScrollBar.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#45464A" Margin="10,5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSubmenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="ItemContainerStyleSelector" Value="{DynamicResource DarkMenuContainerSelector}" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#f0f0f0" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="Padding"
                    Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent">
                            <Border x:Name="ItemBackground"
                                    Margin="3,1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="CheckMark"
                                               Text="✓"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="›"
                                               FontSize="16"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   HorizontalOffset="-3"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="180"
                                        Padding="3"
                                        Background="#252526"
                                        BorderBrush="#3f3f46"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role"
                                     Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="ItemBackground"
                                        Property="Background"
                                        Value="#3a3a3a" />
                                <Setter Property="Foreground"
                                        Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTopLevelMenuItemStyle"
               TargetType="MenuItem">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#f0f0f0" />
            <Setter Property="ItemContainerStyleSelector"
                    Value="{DynamicResource DarkMenuContainerSelector}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderBackground"
                                    Margin="2,2"
                                    Padding="10,4"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   VerticalOffset="-2"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="190"
                                        Padding="3"
                                        Background="#252526"
                                        BorderBrush="#3f3f46"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="HeaderBackground"
                                        Property="Background"
                                        Value="#3a3a3a" />
                                <Setter Property="Foreground"
                                        Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen"
                                     Value="True">
                                <Setter TargetName="HeaderBackground"
                                        Property="Background"
                                        Value="#414141" />
                                <Setter Property="Foreground"
                                        Value="#ffffff" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenuStyle"
               TargetType="ContextMenu">
            <Setter Property="Background"
                    Value="#252526" />
            <Setter Property="Foreground"
                    Value="#f0f0f0" />
            <Setter Property="BorderBrush"
                    Value="#3f3f46" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="3" />
            <Setter Property="ItemContainerStyleSelector"
                    Value="{DynamicResource DarkMenuContainerSelector}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border MinWidth="180"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCaptionButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="#f0f0f0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="#404040" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="#505050" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver"
                                               Value="True" />
                                    <Condition Property="Tag"
                                               Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="#c42b1c" />
                                <Setter Property="Foreground"
                                        Value="#ffffff" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed"
                                               Value="True" />
                                    <Condition Property="Tag"
                                               Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionBackground"
                                        Property="Background"
                                        Value="#a92316" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTitleButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="#f0f0f0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#72D6C5" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3a3a3a" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#464646" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:MenuContainerStyleSelector x:Key="DarkMenuContainerSelector"
            MenuItemStyle="{StaticResource DarkSubmenuItemStyle}"
            SeparatorStyle="{StaticResource {x:Type Separator}}" />
        <Style x:Key="ChromeTabButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkTitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusBorder" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="#A8C7FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeRoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkTitleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="16" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#404145" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Background" Value="#515256" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="Background" Value="#454F60" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="8,8,8,12" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <DockPanel Background="#0c0c0c">
        <Grid DockPanel.Dock="Top"
              Height="46"
              Background="#202124">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="TitleTabsHost" Grid.Column="0" Margin="8,0,20,0" LastChildFill="False"
                       SizeChanged="TitleTabsHost_SizeChanged">
                <ScrollViewer x:Name="TabScroller" DockPanel.Dock="Left" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroller_PreviewMouseWheel"
                              HorizontalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </ScrollViewer>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="4,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="NewTabButton" Width="32" Height="30" Content="+" FontSize="20"
                            HorizontalContentAlignment="Center" ToolTip="New terminal (Ctrl+Shift+T)"
                            Style="{StaticResource ChromeRoundButtonStyle}" Click="NewTabButton_Click"
                            AutomationProperties.Name="New terminal" />
                    <Button Width="26" Height="30" Content="⌄" FontSize="14"
                            HorizontalContentAlignment="Center" ToolTip="Terminal profiles"
                            Style="{StaticResource DarkTitleButtonStyle}" Click="ProfileMenuButton_Click"
                            AutomationProperties.Name="Terminal profiles" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="46"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize"
                        Click="MinimizeButton_Click">
                    <Path Width="10" Height="10" Data="M0,5 L10,5" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="MaximizeButton"
                        Width="46"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        ToolTip="Maximize / Restore" AutomationProperties.Name="Maximize or restore"
                        Click="MaximizeButton_Click">
                    <Path x:Name="MaximizeGlyph" Width="10" Height="10" Data="M0.5,0.5 L9.5,0.5 9.5,9.5 0.5,9.5 Z" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Width="46"
                        Style="{StaticResource WindowCaptionButtonStyle}"
                        Tag="Close"
                        ToolTip="Close window" AutomationProperties.Name="Close window"
                        Click="CloseWindowButton_Click">
                    <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" StrokeThickness="1"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="#303134" BorderBrush="#3C4043" BorderThickness="0,0,0,1">
        <DockPanel Margin="8,0,14,3">
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10" Margin="14,0,0,0"
                   ToolTip="Smart RTL automatically handles Persian and mixed-direction text">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="●  SMART RTL" />
                    <Setter Property="Foreground" Value="#72D6C5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=SmartRtlMenuItem}" Value="False">
                            <Setter Property="Text" Value="RTL OFF" />
                            <Setter Property="Foreground" Value="#8B949E" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Menu Height="28" FontFamily="Segoe UI" FontSize="12"
              Background="Transparent"
              Foreground="#f0f0f0"
              ItemContainerStyle="{StaticResource DarkTopLevelMenuItemStyle}">
            <MenuItem Header="_File">
                <MenuItem x:Name="LastDirectoriesMenuItem"
                          Header="_Last directories"
                          SubmenuOpened="LastDirectoriesMenuItem_SubmenuOpened">
                    <MenuItem Header="No recent directories"
                              IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Export session..."
                          Click="ExportSessionMenuItem_Click" />
                <Separator />
                <MenuItem Header="E_xit"
                          Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Font settings..."
                          Click="FontSettingsMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="SmartRtlMenuItem"
                          Header="_Smart RTL"
                          IsCheckable="True"
                          ToolTip="Use right-to-left layout only for lines containing RTL letters"
                          Checked="SmartRtlMenuItem_Changed"
                          Unchecked="SmartRtlMenuItem_Changed" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="ContextMenuIntegrationMenuItem"
                          Header="Add _Open in RtlTerminal"
                          IsCheckable="True"
                          Click="ContextMenuIntegrationMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Guide"
                          Click="GuideMenuItem_Click" />
                <MenuItem x:Name="CheckForUpdatesMenuItem"
                          Header="Check for _updates..."
                          Click="CheckForUpdatesMenuItem_Click" />
                <Separator />
                <MenuItem Header="_About Rtl Terminal"
                          Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>
        </DockPanel>
        </Border>

        <local:TerminalView x:Name="TerminalTextBox"
                     Background="#0c0c0c"
                     Foreground="#e6e6e6"
                     BorderThickness="0"
                     Padding="10"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="14"
                     Cursor="IBeam"
                     FlowDirection="LeftToRight"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType"
                     Typography.StandardLigatures="False"
                     Typography.ContextualLigatures="False"
                     Typography.DiscretionaryLigatures="False"
                     Typography.Kerning="False"
                     Typography.NumeralAlignment="Tabular"
                     ScrollViewer.ScrollChanged="TerminalTextBox_ScrollChanged"
                     PreviewKeyDown="TerminalTextBox_PreviewKeyDown"
                     PreviewKeyUp="TerminalTextBox_PreviewKeyUp"
                     PreviewMouseDown="TerminalTextBox_PreviewMouseDown"
                     PreviewMouseUp="TerminalTextBox_PreviewMouseUp"
                     PreviewMouseMove="TerminalTextBox_PreviewMouseMove"
                     PreviewMouseWheel="TerminalTextBox_PreviewMouseWheel"
                     PreviewMouseRightButtonDown="TerminalTextBox_PreviewMouseRightButtonDown"
                     GotKeyboardFocus="TerminalTextBox_GotKeyboardFocus"
                     LostKeyboardFocus="TerminalTextBox_LostKeyboardFocus"
                     PreviewTextInput="TerminalTextBox_PreviewTextInput" />
    </DockPanel>
    </Border>
</Window>
