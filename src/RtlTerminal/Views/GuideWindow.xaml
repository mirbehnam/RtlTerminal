<Window x:Class="RtlTerminal.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RtlTerminal"
        Title="راهنمای Rtl Terminal"
        Icon="/RtlTerminal;component/Assets/RtlTerminal.ico"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#10151f">
    <Window.Resources>
        <Style x:Key="GuideCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#172234" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="GuideTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#56b4ff" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style x:Key="GuideTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e4eaf4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="25" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GuideNoteStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource GuideTextStyle}">
            <Setter Property="Foreground" Value="#ffcf70" />
        </Style>
        <Style x:Key="LanguageButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#e4eaf4" />
            <Setter Property="Background" Value="#263650" />
            <Setter Property="BorderBrush" Value="#3c526f" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="GuideTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#d4deed"/>
            <Setter Property="Background" Value="#172234"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="0,0,8,8">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1970a8"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ContentRoot" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#172234" Padding="24,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="GuideHeading"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="GuideSubtitle"
                               Margin="0,7,0,0"
                               Foreground="#aebbd0"
                               FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight">
                    <Button x:Name="PersianButton"
                            Style="{StaticResource LanguageButtonStyle}"
                            Tag="Persian"
                            Content="فارسی"
                            Click="LanguageButton_Click" />
                    <Button x:Name="ArabicButton"
                            Style="{StaticResource LanguageButtonStyle}"
                            Tag="Arabic"
                            Content="العربية"
                            Click="LanguageButton_Click" />
                    <Button x:Name="EnglishButton"
                            Style="{StaticResource LanguageButtonStyle}"
                            Tag="English"
                            Content="English"
                            Click="LanguageButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="GuideTabs" Grid.Row="1" Margin="18,14,18,0" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GuideTabStyle}">
        <TabItem x:Name="FeaturesTab">
        <ScrollViewer
                      Padding="24"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource GuideCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="DirectionTitle"
                                   Style="{StaticResource GuideTitleStyle}" />
                        <TextBlock x:Name="DirectionText"
                                   Style="{StaticResource GuideTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GuideCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ClipboardTitle"
                                   Style="{StaticResource GuideTitleStyle}" />
                        <TextBlock x:Name="ClipboardText"
                                   Style="{StaticResource GuideTextStyle}" />
                        <TextBlock x:Name="ClipboardNote"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource GuideNoteStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GuideCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="LinksTitle"
                                   Style="{StaticResource GuideTitleStyle}" />
                        <TextBlock x:Name="LinksText"
                                   Style="{StaticResource GuideTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GuideCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ContextMenuTitle"
                                   Style="{StaticResource GuideTitleStyle}" />
                        <TextBlock x:Name="ContextMenuText"
                                   Style="{StaticResource GuideTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GuideCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="KeysTitle"
                                   Style="{StaticResource GuideTitleStyle}" />
                        <TextBlock x:Name="KeysText"
                                   Style="{StaticResource GuideTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GuideCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="MacrosGuideTitle" Style="{StaticResource GuideTitleStyle}" />
                        <TextBlock x:Name="MacrosGuideText" Style="{StaticResource GuideTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        <TabItem x:Name="ShortcutsTab">
            <DockPanel Margin="8,4,8,12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="ShortcutSearchLabel" Foreground="#aebbd0" Margin="0,0,0,7"/>
                    <TextBox x:Name="ShortcutSearchBox" TextChanged="ShortcutSearch_Changed" Padding="10,8" FontSize="14" Foreground="#e4eaf4" Background="#172234" BorderBrush="#3c526f" CaretBrush="White"/>
                    <TextBlock x:Name="ShortcutNote" Style="{StaticResource GuideNoteStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ShortcutEmptyText" Style="{StaticResource GuideTextStyle}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ShortcutRows">
                        <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="#56b4ff" FontWeight="SemiBold" FontSize="16" Margin="0,15,0,9"/>
                        </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="#172234" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontSize="13" Foreground="#ffcf70" FlowDirection="LeftToRight" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="#e4eaf4" FontSize="14" LineHeight="22" TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
